@using DynamicAuthBlazor.Web.Shared
@using Microsoft.AspNetCore.Components.Authorization
<!-- App.razor -->
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <!-- 🔒 By adding the AuthorizeRouteView, Blazor treats all matching pages as protected by default -->
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <!-- 🚀 CASE A: User IS logged in, but just lacks this specific permission claim -->
                        <div class="container mt-5 text-center">
                            <div class="card p-5 shadow border-danger mx-auto" style="max-width: 500px;">
                                <h3 class="text-danger mb-3">⛔ Access Denied</h3>
                                <p class="text-muted">
                                    You are authenticated as <strong>@context.User.Identity.Name</strong>,
                                    but you do not possess the authorization privileges required to access this page.
                                </p>
                                <a href="/" class="btn btn-outline-primary mt-3">Return to Safe Dashboard</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <!-- 🚀 CASE B: User is NOT logged in at all -> Send them to the login layout -->
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                
                <Authorizing>
                    <div class="text-center mt-5">
                        <div class="spinner-border text-primary" role="status"></div>
                        <p class="mt-2 text-muted">Verifying secure session context...</p>
                    </div>
                </Authorizing>
                
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert" class="alert alert-danger m-3">The requested page could not be found.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>