

@page "/login"

@layout EmptyLayout


@using DynamicAuthBlazor.Web.Services
@using Entities.UIModels

@inject NavigationManager NavigationManager
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="card p-4 shadow-sm" style="width: 100%; max-width: 400px; border-radius: 10px;">
        <div class="card-body">
            <h3 class="card-title text-center mb-4 font-weight-bold">Sign In</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger role="alert">
                    @errorMessage
                </div>
            }

            <EditForm Model="@loginUser" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <DataAnnotationsValidator />

                <!-- Email Input -->
                <div class="mb-3">
                    <label for="username" class="form-label">User Name</label>
                    <InputText id="username" class="form-control" @bind-Value="loginUser.username" placeholder="name@example.com" />
                    <ValidationMessage For="@(() => loginUser.username)" class="text-danger small" />
                </div>

                <!-- Password Input -->
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="loginUser.Password" placeholder="••••••••" />
                    <ValidationMessage For="@(() => loginUser.Password)" class="text-danger small" />
                </div>

                <!-- Remember Me & Forgot Password Links -->
            

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary w-100 py-2" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Signing in...</span>
                    }
                    else
                    {
                        <span>Login</span>
                    }
                </button>
            </EditForm>

            <div class="text-center mt-4">
                <p class="small mb-0">Don't have an account? <a href="/register" class="text-decoration-none fw-bold">Sign up</a></p>
            </div>
        </div>
    </div>
</div>

@code {
    @attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
    public LoginModel loginUser = new();
    private string? errorMessage;
    private bool isSubmitting = false;

    [Inject]
    public IAuthService? _authService { get; set; }

    public async Task HandleLogin()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            // TODO: Call your authentication backend or AuthenticationStateProvider API here.
            var result = await _authService.LoginAsync(loginUser);

            // Simulating an API call latency
            await Task.Delay(1500);

            bool loginSuccessful = result.IsSuccess; // Replace with actual validation logic

            if (loginSuccessful)
            {
                NavigationManager.NavigateTo("/Home", forceLoad: true);
            }
            else
            {
                errorMessage = "Invalid email or password combination.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}