@page "/catalog"
@using DynamicAuthBlazor.Web.Services
@using Entities.Models
@using Entities.Shopping
@using Microsoft.AspNetCore.Authorization
@inject CartService CartService
@attribute [Authorize(Roles = "Admin, Customer")]
<div class="container py-5" style="max-width: 1200px; font-family: 'Segoe UI', system-ui, sans-serif;">

    <!-- HEADER BAR -->
    <div class="border-bottom pb-3 mb-4">
        <h2 class="fw-bold text-dark m-0">Verified Product Registry</h2>
        <p class="text-muted small mb-0">Browse certified items directly sourced from verified partner warehouses.</p>
        <div class="col-3 ms-auto text-end">
            <span class="bi bi-cart-fill" aria-hidden="true"></span> <a class="accordion-button" href="cart">Cart</a>
            @if (CartCount > 0)
            {
                <span class="badge bg-danger ms-2">@CartCount</span>
            }
        </div>
    </div>

    <!-- PRODUCT GRID MATRIX -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @if (verifiedProducts == null)
        {
            <p>Loading catalog infrastructure...</p>
        }
        else
        {
            @foreach (var item in verifiedProducts)
            {
                
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm custom-card overflow-hidden bg-white">

                        <!-- 🖼️ 1. IMAGE OF THE PRODUCT -->
                        <div class="bg-light p-4 text-center position-relative border-bottom d-flex align-items-center justify-content-center" style="height: 180px;">
                            <span class="display-3">
                                <img src="@item.ImageUrl"/>
                               
                            </span>
                        </div>

                        <!-- CONTENT HOOK -->
                        <div class="card-body p-3 d-flex flex-column">

                            <!-- 🏷️ 2. NAME -->
                            <h6 class="fw-bold text-dark text-truncate mb-1" title="@item.Name">
                                @item.Name
                            </h6>

                            <!-- 🏢 4. SUPPLIER -->
                            <div class="d-flex align-items-center gap-1 mb-3 text-muted" style="font-size: 0.8rem;">
                                <span>🏢 Supplier:</span>
                                <span class="fw-semibold text-indigo text-truncate" style="max-width: 160px;">@item.seller</span>
                            </div>

                            <!-- 💰 3. PRICE & ACTION CONTROLS -->
                            <div class="d-flex justify-content-between align-items-center pt-2 border-top mt-auto">
                                <div>
                                    <small class="d-block text-muted text-uppercase tracking-wider" style="font-size: 0.65rem;">Price</small>
                                    <span class="fs-5 fw-extrabold text-dark">₹@item.price.ToString("N0")</span>
                                </div>
                                @if (item.isInStock)
                                {
                                    <button class="btn btn-indigo btn-sm px-3 py-2 fw-semibold rounded-3 text-white" @onclick="() => HandleButtonClick(item.id)">
                                        Add To Cart
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-danger btn-sm px-3 py-2 fw-semibold rounded-3 text-white">
                                        Sold Out
                                    </button>
                                }

                            </div>
                           
                        </div>
                    </div>
                </div>

            }
        }
    </div>
</div>

<style>
    /* Styling Palette Tokens */
    .bg-indigo {
        background-color: #4f46e5 !important;
    }

    .text-indigo {
        color: #4f46e5 !important;
    }

    .btn-indigo {
        background-color: #4f46e5;
        border: none;
        font-size: 0.85rem;
        transition: background-color 0.2s ease;
    }

        .btn-indigo:hover {
            background-color: #4338ca;
        }

    .fw-extrabold {
        font-weight: 800;
    }

    /* Layout Component Motion physics */
    .custom-card {
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid #f3f4f6 !important;
        border-radius: 16px;
    }

        .custom-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.05) !important;
            border-color: #e5e7eb !important;
        }
</style>

@code {
    private IEnumerable<Prouduct_responseDTO> verifiedProducts;

    [Inject]
    IProductRepository productRepository { get; set; }

    private int CartCount => CartService.GetTotalCount();
    protected override async void OnInitialized()
    {
        await LoadCatalogData();
        // Subscribe to state changes
        CartService.OnCartChanged += StateHasChanged;
    }

    public void Dispose()
    {
        // Unsubscribe to avoid memory leaks
        CartService.OnCartChanged -= StateHasChanged;
    }
    private async Task LoadCatalogData()
    {
        verifiedProducts = await productRepository.getAllProductsAsync();
        // Populating cleanly structured objects matching the exact target columns requested
        StateHasChanged();
    }

    private async void HandleButtonClick(Guid? product_id)
    {
        var selectedProduct = verifiedProducts.Where(x => x.id == product_id).FirstOrDefault();
        var cartItem = new CartItem
        {
            product_uid = selectedProduct.id,
            Name = selectedProduct.Name,
            Price = selectedProduct.price,
            ImageUrl = selectedProduct.ImageUrl,
            Quantity = 1,
            MaxStock = selectedProduct.CurrentStock // Replace with your actual database stock quantity if available
        };

       await CartService.AddToCartAsync(cartItem);
    }
}